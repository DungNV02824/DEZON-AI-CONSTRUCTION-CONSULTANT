DATABASE_URL=postgresql+psycopg://dezon:dezon@localhost:5433/dezon
REDIS_URL=redis://localhost:6379/0
# --- AI: điền OPENAI_API_KEY là hệ thống tự dùng OpenAI; để trống -> chế độ giả lập (mock) ---
OPENAI_API_KEY=              # bí danh của LLM_API_KEY và EMBEDDING_API_KEY
MODEL_NAME=gpt-4.1-mini      # bí danh của LLM_MODEL
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=auto            # auto | mock | openai | anthropic
EMBEDDING_PROVIDER=auto      # auto | hash (cục bộ) | openai
# LLM_API_KEY=               # key của provider đang chọn; Claude: đặt key Anthropic ở đây (hoặc ANTHROPIC_API_KEY)
# LLM_MODEL=                 # vd gpt-4.1-mini hoặc tên model Claude khi LLM_PROVIDER=anthropic
# LLM_BASE_URL=              # endpoint LLM tương thích khác (tùy chọn)
# MAX_TOOL_ROUNDS=6          # số vòng gọi tool tối đa mỗi lượt chat
# EMBEDDING_API_KEY=         # mặc định lấy OPENAI_API_KEY
# EMBEDDING_API_BASE=        # endpoint /embeddings tương thích OpenAI khác; trống -> https://api.openai.com/v1
# EMBEDDING_DIM=1536         # phải khớp cột vector(1536) của bảng documents
DEZON_API_BASE_URL=
DEZON_API_TOKEN=
DEZON_SITE_URL=https://dezon.vn
STALE_DAYS=180
ALLOWED_ORIGINS=https://dezon.vn,http://localhost:5173,http://localhost:8080
APP_ENV=development          # production: trang quản trị bị khóa nếu ADMIN_TOKEN còn mặc định
ADMIN_TOKEN=change-me
IMPORT_DIR=data/imports      # admin chỉ nhập được file theo đường dẫn trong thư mục này
CHAT_RATE_LIMIT_PER_MIN=20   # tin/phút/IP khách — sau reverse proxy phải đặt FORWARDED_ALLOW_IPS
# IP/subnet reverse proxy được tin cho X-Forwarded-For (docker-compose truyền vào uvicorn --proxy-headers).
# Mặc định 127.0.0.1. Proxy ở container/máy khác: đặt IP/subnet của nó (vd 172.16.0.0/12), nếu không mọi khách
# chung một bucket rate limit. KHÔNG đặt * khi cổng backend mở thẳng ra Internet (khách giả mạo được IP).
FORWARDED_ALLOW_IPS=127.0.0.1
# Seed nạp snapshot dữ liệu thật dezon.vn (app/db/seed_data/dezon_snapshot.json). docker-compose mặc định 1.
# Khi chạy seed ngoài Docker, biến này đọc từ môi trường thật (export SEED_SNAPSHOT=1), không đọc từ file .env.
SEED_SNAPSHOT=1
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
